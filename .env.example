# Google Gemini Configuration
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appbuilder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appbuilder

# Application Configuration
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=5000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Generated Apps Directory
GENERATED_APPS_DIR=./generated
APPBUILDER_ALLOWED_ROOTS=

# CORS origins as JSON, for example:
# CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:5000"]

# Agent Configuration
MAX_RETRIES=3
AGENT_TIMEOUT=300

# Docker Configuration
DOCKER_NETWORK=appbuilder-network
